{
  "name": "language-trainer",
  "version": "0.1.0",
  "description": "Practise spoken English in the browser: talk to a tutor, get every sentence corrected.",
  "license": "MIT",
  "homepage": "https://tatuck.github.io/language-trainer/",
  "repository": {
    "type": "git",
    "url": "https://github.com/Tatuck/language-trainer.git"
  },
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev -H 127.0.0.1",
    "build": "next build",
    "serve": "python3 -m http.server -d out 3001",
    "lint": "eslint",
    "test": "vitest run",
    "typecheck": "next typegen && tsc --noEmit",
    "spike": "tsx --env-file=.env.local scripts/spike-audio.ts"
  },
  "dependencies": {
    "next": "16.3.5",
    "openai": "^7.15.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/dom-speech-recognition": "^0.0.12",
    "@types/node": "^24.13.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^5.0.0"
  }
}

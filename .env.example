# OpenRouter API key (https://openrouter.ai/keys)
OPENROUTER_API_KEY=
# Model for chat replies. Tip: google/gemini-3.8-flash answers ~3x faster (TTFT ~2 s vs ~6 s).
OPENROUTER_MODEL=meta/muse-spark-1.3
# Model for audio → transcript/analysis. Must understand audio well; muse-spark does not (see docs/decisions.md).
OPENROUTER_AUDIO_MODEL=google/gemini-3.8-flash
